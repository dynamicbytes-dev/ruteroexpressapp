# Plantilla de producción de GAZ. No contiene secretos reales.
# En el servidor, cópiala como backend/.env y completa los valores. Ese archivo
# está ignorado por Git.

APP_NAME="GAZ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Caracas
APP_URL=https://panel.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Supabase GAZ (pooler de sesión). Completa DB_PASSWORD con la contraseña de
# `gaz_app`; no la subas al repositorio.
DB_CONNECTION=pgsql
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=gaz_app.prmgzklfmsmxobqkkpvc
DB_PASSWORD=
DB_SSLMODE=require
DB_SEARCH_PATH=public,extensions

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Si el panel y la API comparten dominio, deja SESSION_DOMAIN=null.
# Si usas subdominios, por ejemplo panel.example.com y api.example.com,
# configura SESSION_DOMAIN=.example.com y ajusta SANCTUM_STATEFUL_DOMAINS.

SANCTUM_STATEFUL_DOMAINS=panel.example.com

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Usa un proveedor transaccional con SPF/DKIM/DMARC en producción.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# No ejecutes el seeder de auditor de desarrollo en producción.
# AUDITOR_INITIAL_PASSWORD=

GEOAPIFY_API_KEY=
GEOAPIFY_ROUTING_MODE=motorcycle

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="GAZ/1.0 (+https://example.com)"

GOOGLE_MAPS_SERVER_KEY=

# Firebase Cloud Messaging. El JSON de la cuenta de servicio debe existir en
# el servidor y estar fuera de Git (storage/app ya está ignorado).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=storage/app/firebase/firebase-service-account.json

# Regla de negocio actual: solo correos Gmail. Cámbiala si el lanzamiento
# debe aceptar otros dominios.
MOTORUTA_ALLOWED_EMAIL_DOMAINS=gmail.com
MOTORUTA_SERVICE_FEE_PERCENT=10
MOTORUTA_ROAD_FACTOR=1.25
MOTORUTA_ROUTE_SPEED_KMH=25
MOTORUTA_DRIVER_OFFLINE_MINUTES=5

BCV_API_URL=https://www.bcv.org.ve/tasas-cambio
BCV_API_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"

# Reverb detrás de TLS. El proceso Reverb escucha en 8080 y el proxy publica
# wss://... en 443. La app móvil debe compilarse con los mismos host/puerto.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="ws.example.com"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
