APP_NAME="gaz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos local en Docker (postgis/postgis:17-3.5, puerto 5433).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=motoruta
DB_USERNAME=motoruta
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Tiempo real: Reverb (WebSockets). La app y el panel se conectan aquí.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Para Gmail con contraseña de aplicación: MAIL_SCHEME=smtp, puerto 587.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@motoruta.app"
MAIL_FROM_NAME="${APP_NAME}"

# Contraseña inicial del auditor de desarrollo. Si se omite, el seeder genera
# una aleatoria y la guarda en storage/auditor-password.txt (ignorado por git).
# AUDITOR_INITIAL_PASSWORD=

# Geoapify: mapas, rutas (modo moto o carro) y búsqueda de direcciones.
# Es gratis y no pide tarjeta. Sin clave se usan tiles de OpenStreetMap,
# Nominatim para direcciones y la estimación local para rutas.
GEOAPIFY_API_KEY=
GEOAPIFY_ROUTING_MODE=motorcycle

# Respaldo de direcciones en OpenStreetMap (no requiere cuenta).
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="GAZ/1.0 (+https://motoruta.app)"

# Opcional: Directions/Geocoding de Google, solo si algún día hay clave.
GOOGLE_MAPS_SERVER_KEY=

# Firebase Cloud Messaging (notificaciones push, F4)
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Reglas de negocio configurables por el auditor (semilla, ver docs/reglas-negocio.md)
MOTORUTA_ALLOWED_EMAIL_DOMAINS=gmail.com
MOTORUTA_SERVICE_FEE_PERCENT=10
# Estimación local de rutas cuando no hay Geoapify ni Google
MOTORUTA_ROAD_FACTOR=1.25
MOTORUTA_ROUTE_SPEED_KMH=25
# Minutos sin reportar ubicación antes de marcar al conductor desconectado
MOTORUTA_DRIVER_OFFLINE_MINUTES=5

# Fuente externa para la tasa de cambio del dólar (BCV por defecto).
# Se usa con `php artisan tasa:actualizar` (programado diariamente a las 08:00).
BCV_API_URL=https://www.bcv.org.ve/tasas-cambio
BCV_API_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSockets en desarrollo). `php artisan install:broadcasting
# --reverb` genera estos valores; en producción se fijan a mano.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
